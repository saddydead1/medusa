# Примеры запуска. Это не «скопируй и беги»: панель и нода — разные процессы,
# у каждого свой набор переменных.

# ---- панель ----
MEDUSA_DB=./data/medusa.db
MEDUSA_ADMIN_USER=admin
# без этой переменной пароль владельца генерируется и печатается в лог при первом запуске
MEDUSA_ADMIN_PASSWORD=change-me-long-enough
# MEDUSA_DEMO=1        # демо-данные при первом запуске пустой базы
# MEDUSA_AUTH=0        # учётка вообще не нужна: только для разработки на своей машине
#                       (по умолчанию включено: API закрыт без токена сессии)
# MEDUSA_PANEL_BASE=https://panel.example.com   # публичный адрес панели: нужен за HTTPS-прокси
#                       и для входа по аппаратному ключу (WebAuthn сверяет адрес панели)
# MEDUSA_NODE_AUTO=0    # выключить фоновый опрос нод (панель будет ходить к нодам сама по умолчанию)

# ---- нода (её собственный запуск, панель этих переменных не видит) ----
MEDUSA_NODE_HOST=0.0.0.0
MEDUSA_NODE_PORT=9443                 # отдельный порт API: клиентские порты Xray его не касаются
MEDUSA_NODE_STATE=./data/node/state.json
# без MEDUSA_NODE_API_KEY нода создаёт API-ключ сама, хранит его в файле состояния
# (0600) и печатает в лог один раз — этот ключ вводят в панели при добавлении ноды
# MEDUSA_NODE_API_KEY=sk-api-...            # можно задать свой, тогда нода не будет создавать свой
# MEDUSA_XRAY_BIN=/usr/local/bin/xray
